<!-- EXCV focused definition - Suzuki GSX-R1000 M7 (RH850) - for CalStudio -->
<!-- Only the verified Exhaust Control Valve items: valve control + P14xx DTC control. -->
<!-- Values code-proven from 32990-48L00 via Ghidra V850 decompile. UNVERIFIED ON HARDWARE. -->
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>GSX-R1000 M7 - EXCV (Exhaust Control Valve) control + DTCs</deftitle>
    <description>Focused Exhaust Control Valve definition for the Suzuki GSX-R1000 M7 ECU (Renesas RH850), base 32990-48L00. Contains ONLY the items needed to control the valve and its DTCs: 2 motor voltage-comp maps, open/closed/decision/gate target setpoints, master-enable and output-arm flags, drive-time and direction-hysteresis scalars; plus the 6 P1400/P1402/P1404 MIL-enable flags and 7 position-sensor monitor thresholds. All values code-proven from the binary. Scaling raw unless noted. UNVERIFIED ON HARDWARE.</description>
    <author>Clint Chipley / Claude</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="1" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x200000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="2 MB full read" />
    <CATEGORY index="0x0" name="EXCV - Valve Control" />
    <CATEGORY index="0x1" name="EXCV - DTC Control (MIL enables + monitor thresholds)" />
  </XDFHEADER>
  <XDFTABLE uniqueid="0x10" flags="0x0">
    <title>EXCV :: Motor drive voltage-comp map A (duty x battery V)</title>
    <description>CURATED (code-proven): EXCV H-bridge drive voltage-compensation, bank A. FUN_0004C8D0 looks this up by commanded duty (0-255) x battery voltage (0xFEBF63C4) to scale PWM so valve speed is constant across Vbatt; feeds fef00dd2/dd3, final H-bridge PWM at 0xFEBF603D/603E. Previously mislabeled 'Fuel :: Primary Trim'; stock cells near-neutral (0x80). PORTED FROM HAYABUSA 5JCZSJ10 (HIGH: breakpoints byte-identical, almost certainly the same map). Units/scaling carried over; GSX-R</description>
    <CATEGORYMEM index="0" category="1" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x1587AC" mmedelementsizebits="16" mmedcolcount="23" mmedmajorstridebits="0" mmedminorstridebits="0" />
