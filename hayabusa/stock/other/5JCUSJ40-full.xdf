    <CATEGORY index="0x7" name="Ignition Offset" />
    <CATEGORY index="0x8" name="Ignition Volt-Dwell" />
    <CATEGORY index="0x9" name="Deceleration Fuel Cut" />
    <CATEGORY index="0xA" name="Throttle By Wire" />
    <CATEGORY index="0xB" name="PWR-1" />
    <CATEGORY index="0xC" name="PWR-2" />
