<!-- Written by make_other_xdf.py - Hayabusa Gen3 other-line (5JCU/5JE0), maps from on-bin descriptors -->
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>Suzuki Hayabusa Gen3 5JCUSJ40 (32990-10L4) - maps from on-bin descriptors (auto)</deftitle>
    <description>Suzuki Hayabusa Gen3 (RH850/F1L), 2 MB read, sw 5JCUSJ40 (ECM 32990-10L4), "other" line (5JCU/5JE0). 748 maps/curves built from THIS read's on-bin descriptor table (748 HIGH = breakpoints match 5JCZ, 0 MED = verify, 0 unknown), definitions ported from the 5JCZSJ10 master. NOT compatible with 5JCZ XDFs (different build; descriptors relocated). Scalar constants/flags are NOT included - they have no descriptor and need a 5JCU/5JE0 Ghidra decompile. Re-stamp field-1 CRC (0x10000-0x1FFAFB @0x1FFAFE) with tools/fix_field1_crc.py after editing. UNVERIFIED ON HARDWARE - keep a stock read for recovery.</description>
    <author>Clint Chipley / Claude</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="1" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x200000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="2 MB full read" />
    <CATEGORY index="0x0" name="xdf bin files" />
    <CATEGORY index="0x1" name="Fuel" />
    <CATEGORY index="0x2" name="TPS" />
    <CATEGORY index="0x3" name="IAP" />
    <CATEGORY index="0x4" name="Neutral/Clutch-In" />
