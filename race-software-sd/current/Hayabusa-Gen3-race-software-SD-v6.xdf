    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x15E3FC" mmedelementsizebits="16" mmedcolcount="50" mmedmajorstridebits="0" mmedminorstridebits="0" />
